<Window x:Class="WordDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WordDesk"
        Width="1200"
        Height="800"
        MinWidth="850"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <DockPanel Background="#E5E5E5">

        <!-- TOP TOOLBAR -->
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,0,1">

            <StackPanel>

                <Grid Margin="6">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">

                        <Button Content="New"
                                Click="New_Click"/>

                        <Button Content="Open"
                                Click="Open_Click"/>

                        <Button Content="Save"
                                Click="Save_Click"/>

                        <Button Content="Print"
                                Click="Print_Click"/>

                        <Button Content="PDF"
                                Click="Pdf_Click"/>

                        <Separator Width="10"/>

                        <Button Content="↶ Undo"
                                Click="Undo_Click"/>

                        <Button Content="↷ Redo"
                                Click="Redo_Click"/>

                    </StackPanel>

                    <!-- OPTIONS MENU -->
                    <Menu Grid.Column="1"
                          VerticalAlignment="Center">

                        <MenuItem Header="Options ▾">

                            <MenuItem Header="Simple Mode"
                                      Click="SimpleMode_Click"/>

                            <MenuItem Header="Advanced Mode"
                                      Click="AdvancedMode_Click"/>

                            <Separator/>

                            <MenuItem Header="Developer Settings"
                                      Click="DeveloperSettings_Click"/>

                        </MenuItem>

                    </Menu>

                </Grid>

                <!-- ADVANCED TOOLBAR -->
                <Border x:Name="AdvancedToolbar"
                        Visibility="Collapsed"
                        Background="#F7F7F7"
                        BorderBrush="#DDDDDD"
                        BorderThickness="0,1,0,1"
                        Padding="5">

                    <WrapPanel>

                        <ComboBox x:Name="FontBox"
                                  Width="140"
                                  Margin="3"
                                  SelectionChanged="FontBox_SelectionChanged"/>

                        <ComboBox x:Name="FontSizeBox"
                                  Width="70"
                                  Margin="3"
                                  SelectionChanged="FontSizeBox_SelectionChanged"/>

                        <Button Content="B"
                                FontWeight="Bold"
                                Click="Bold_Click"/>

                        <Button Content="I"
                                FontStyle="Italic"
                                Click="Italic_Click"/>

                        <Button Content="U"
        Click="Underline_Click"/>

                        <Separator Width="10"/>

                        <Button Content="Left"
                                Click="AlignLeft_Click"/>

                        <Button Content="Center"
                                Click="AlignCenter_Click"/>

                        <Button Content="Right"
                                Click="AlignRight_Click"/>

                        <Button Content="Justify"
                                Click="Justify_Click"/>

                        <Separator Width="10"/>

                        <Button Content="Find / Replace"
                                Click="FindReplace_Click"/>

                        <Button Content="Page Settings"
                                Click="PageSettings_Click"/>

                    </WrapPanel>

                </Border>

            </StackPanel>

        </Border>

        <!-- RULER -->
        <Border DockPanel.Dock="Top"
                Height="42"
                Background="#F0F0F0"
                BorderBrush="#BBBBBB"
                BorderThickness="0,0,0,1">

            <Canvas x:Name="RulerCanvas">

                <TextBlock Text="0"
                           Canvas.Left="12"
                           Canvas.Top="15"/>

                <TextBlock Text="1"
                           Canvas.Left="100"
                           Canvas.Top="15"/>

                <TextBlock Text="2"
                           Canvas.Left="200"
                           Canvas.Top="15"/>

                <TextBlock Text="3"
                           Canvas.Left="300"
                           Canvas.Top="15"/>

                <TextBlock Text="4"
                           Canvas.Left="400"
                           Canvas.Top="15"/>

                <TextBlock Text="5"
                           Canvas.Left="500"
                           Canvas.Top="15"/>

                <TextBlock Text="6"
                           Canvas.Left="600"
                           Canvas.Top="15"/>

                <TextBlock Text="7"
                           Canvas.Left="700"
                           Canvas.Top="15"/>

                <TextBlock Text="8"
                           Canvas.Left="800"
                           Canvas.Top="15"/>

                <TextBlock Text="9"
                           Canvas.Left="900"
                           Canvas.Top="15"/>

            </Canvas>

        </Border>

        <!-- DOCUMENT AREA -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

            <Grid Background="#D8D8D8">

                <RichTextBox x:Name="Editor"
                             Width="816"
                             MinHeight="1056"
                             Margin="60"
                             Padding="75"
                             Background="White"
                             FontFamily="Arial"
                             FontSize="12"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             TextChanged="Editor_TextChanged"/>

            </Grid>

        </ScrollViewer>

    </DockPanel>

</Window>
