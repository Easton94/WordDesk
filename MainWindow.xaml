<Window x:Class="WordDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WordDesk"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,0,1"
                Padding="8">

            <StackPanel Orientation="Horizontal">

                <Button Content="New"
                        Width="70"
                        Margin="3"/>

                <Button Content="Open"
                        Width="70"
                        Margin="3"/>

                <Button Content="Save"
                        Width="70"
                        Margin="3"/>

                <Button Content="Print"
                        Width="70"
                        Margin="3"/>

                <Button Content="PDF"
                        Width="70"
                        Margin="3"/>

                <Separator Width="10"/>

                <Button Content="Undo"
                        Width="70"
                        Margin="3"/>

                <Button Content="Redo"
                        Width="70"
                        Margin="3"/>

                <!-- Options dropdown -->
                <ComboBox Width="180"
                          Margin="15,3,3,3"
                          SelectedIndex="0">

                    <ComboBoxItem Content="Options ▾"/>

                    <ComboBoxItem Content="Advanced Mode"/>

                    <ComboBoxItem Content="Developer Settings"/>

                </ComboBox>

            </StackPanel>

        </Border>

        <!-- Ruler -->
        <Border DockPanel.Dock="Top"
                Background="#EEEEEE"
                Height="35"
                BorderBrush="#BBBBBB"
                BorderThickness="0,0,0,1">

            <Canvas>

                <TextBlock Text="0"
                           Canvas.Left="10"
                           Canvas.Top="8"/>

                <TextBlock Text="1"
                           Canvas.Left="100"
                           Canvas.Top="8"/>

                <TextBlock Text="2"
                           Canvas.Left="200"
                           Canvas.Top="8"/>

                <TextBlock Text="3"
                           Canvas.Left="300"
                           Canvas.Top="8"/>

                <TextBlock Text="4"
                           Canvas.Left="400"
                           Canvas.Top="8"/>

                <TextBlock Text="5"
                           Canvas.Left="500"
                           Canvas.Top="8"/>

                <TextBlock Text="6"
                           Canvas.Left="600"
                           Canvas.Top="8"/>

                <TextBlock Text="7"
                           Canvas.Left="700"
                           Canvas.Top="8"/>

                <TextBlock Text="8"
                           Canvas.Left="800"
                           Canvas.Top="8"/>

            </Canvas>

        </Border>

        <!-- Document area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">

            <Grid Background="#D9D9D9"
                  Margin="0">

                <RichTextBox x:Name="Editor"
                             Width="816"
                             MinHeight="1056"
                             Margin="60"
                             Padding="75"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             AcceptsTab="True"
                             FontFamily="Arial"
                             FontSize="12"
                             Background="White"/>

            </Grid>

        </ScrollViewer>

    </DockPanel>

</Window>
